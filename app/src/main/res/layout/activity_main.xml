<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/header_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#8A8A8A"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/header_battery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#6A6A6A"
                android:textSize="16sp" />

            <ImageView
                android:id="@+id/settings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/settings_icon"
                android:padding="10dp"
                android:src="@android:drawable/ic_menu_preferences"
                android:tint="#6A6A6A" />

            <ImageView
                android:id="@+id/power"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/power_icon"
                android:padding="10dp"
                android:src="@android:drawable/ic_lock_power_off"
                android:tint="#6A6A6A" />
        </LinearLayout>

        <!-- Shown while the clock or now playing cannot work yet; opens the setup assistant. -->
        <TextView
            android:id="@+id/setup_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:background="#33E5A100"
            android:padding="12dp"
            android:textColor="#E5A100"
            android:textSize="18sp"
            android:visibility="gone" />

        <!-- Filled from the user's selection: the featured app, then a 2x2 grid. -->
        <LinearLayout
            android:id="@+id/home_apps"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical" />
    </LinearLayout>
</FrameLayout>
